[Unit]
Description=Compet game orchestration server
After=network.target

[Service]
Type=simple
User=@COMPET_USER@
Group=@COMPET_GROUP@
WorkingDirectory=@COMPET_INSTALL_ROOT@
ExecStart="@COMPET_INSTALL_ROOT@/bin/compet" run --config "@COMPET_CONFIG_PATH@"
Restart=on-failure
RestartSec=5s
TimeoutStopSec=150s
KillMode=mixed
SendSIGKILL=no
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
