# Default: store all text files as LF in the repo and check them out as LF
* text=auto eol=lf

# Text source files (explicit, normalized to LF)
*.ts    text eol=lf
*.tsx   text eol=lf
*.cs    text eol=lf
*.sp    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.ps1   text eol=lf
*.bat   text eol=lf

# Binary files: no line-ending conversion
*.jpg   binary
*.png   binary
*.mp3   binary
*.smx   binary
